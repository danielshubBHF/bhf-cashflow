# Copy this file to ".env" (same folder) and fill in the values. ".env" is never committed or shared.

# NetSuite: Setup > Company > Company Information > Account ID
NS_ACCOUNT=5142660
# From the integration record "BHF Cashflow Sync" (shown once when you save it)
NS_CONSUMER_KEY=
NS_CONSUMER_SECRET=
# From the access token for that integration + the read-only role (shown once when you save it)
NS_TOKEN_ID=
NS_TOKEN_SECRET=

# Smartsheet: Account > Personal Settings > API Access > Generate new access token
SMARTSHEET_TOKEN=

# Shared password for the dashboard
DASHBOARD_PASSWORD=

# Test copy of the "0. Cashflow Database" sheets (Claude fills these in once the copy exists)
# SHEET_PROJECTS=
# SHEET_FORECASTS=
# SHEET_TRANSACTIONS=
# SHEET_SCHEDULE=
